rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any signed-in user can read profiles (needed to display friends list,
      // friend search results, and request sender names).
      allow read: if request.auth != null;

      // Owner can create and delete their own profile.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Full update for owner.
      // Any authenticated user may also update pendingFrom or friends arrays —
      // required for sendFriendRequest (A writes to B's pendingFrom) and
      // acceptFriendRequest / removeFriend (both sides write to each other's friends).
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['pendingFrom', 'friends'])
      );

      // ── Sticker collections ────────────────────────────────────────────────
      match /collections/{albumId} {
        // Friends can read each other's collections (for exchange / duplicates view).
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.friends
        );
        // Only the owner can write their collection.
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Premium sub-document ───────────────────────────────────────────────
      match /profile/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Sticker exchange requests ─────────────────────────────────────────────
    match /requests/{requestId} {
      // Only the sender and recipient can read a request.
      allow read: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );

      // Any authenticated user can create a request as the sender.
      allow create: if request.auth != null &&
        request.resource.data.fromUserId == request.auth.uid;

      // Sender or recipient can update (accept, reject, mark received).
      allow update: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Quiniela El Batazo — shared Firebase project (control-de-postales)
    // ═══════════════════════════════════════════════════════════════════════════

    // Helper: check if the caller is an admin of a group
    function isGroupAdmin(groupId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds;
    }

    // ── Quiniela groups ───────────────────────────────────────────────────────
    match /groups/{groupId} {
      // Any signed-in user can read (needed for invite-link join flow)
      allow read: if request.auth != null;

      // Creator must include themselves in adminIds
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.adminIds;

      // Only group admins can update or delete
      allow update: if request.auth != null && isGroupAdmin(groupId);
      allow delete: if request.auth != null && isGroupAdmin(groupId);

      // ── Admin changelog (append-only from client) ──────────────────────────
      match /changelog/{entryId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      // ── Leaderboard (written exclusively by Cloud Functions) ───────────────
      match /leaderboard/{userId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Group membership ──────────────────────────────────────────────────────
    match /groupMembers/{memberId} {
      // Any signed-in user can read (needed for member list and join-status checks)
      allow read: if request.auth != null;

      // User can send their own join request
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Admin can accept/reject; member can withdraw their own request
      allow update: if request.auth != null && (
        isGroupAdmin(resource.data.groupId) ||
        resource.data.userId == request.auth.uid
      );

      // Admin can remove members; member can leave
      allow delete: if request.auth != null && (
        isGroupAdmin(resource.data.groupId) ||
        resource.data.userId == request.auth.uid
      );
    }

    // ── Score predictions ─────────────────────────────────────────────────────
    match /predictions/{predictionId} {
      // Any group member can read predictions (leaderboard transparency)
      allow read: if request.auth != null;

      // Users can only create/update their own predictions
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Predictions are immutable once the match starts (enforced by Cloud Functions);
      // clients cannot delete predictions
      allow delete: if false;
    }

    // ── Special predictions (champion, top scorer) ────────────────────────────
    match /specialPredictions/{predictionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Tournament & match data (read-only for clients) ───────────────────────
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions only
    }

    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions only
    }
  }
}
